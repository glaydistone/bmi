			<property name="javax.persistence.jdbc.url"
				value="jdbc:mysql://localhost/boletim?autoReconnect=true" />
			<property name="javax.persistence.jdbc.user" value="boletim" />
			<property name="javax.persistence.jdbc.password" value="bmi" />
			<property name="validationQuery" value="SELECT 1" />
			<property name="javax.persistence.jdbc.driver"
				value="com.mysql.jdbc.Driver" />
