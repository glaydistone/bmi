<beans:beans
	xmlns="http://www.springframework.org/schema/security"
	xmlns:beans="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
           http://www.springframework.org/schema/security
           http://www.springframework.org/schema/security/spring-security-3.1.xsd">

	<http pattern="/javax.faces.resource/**" security="none" />

	<beans:bean id="appUserDetailsService"
		class="br.com.tecnotran.bmi.model.AppUserDetailsService" />
	<http pattern="/Login.xhtml" security="none" />
	<http pattern="/Erro.xhtml" security="none" />

	<beans:bean id="jsfAccessDeniedHandler"
		class="br.com.tecnotran.bmi.controller.seguranca.JsfAccessDeniedHandler">
		<beans:property name="loginPath"
			value="/AcessoNegado.xhtml" />
		<beans:property name="contextRelative" value="true" />
	</beans:bean>

	<!-- redirecionamento 



	<beans:bean id="authenticationEntryPoint"
		class="br.com.tecnotran.bmi.controller.seguranca.JsfLoginUrlAuthenticationEntryPoint">
		<beans:property name="loginFormUrl"
			value="/spring/login" />
		<beans:property name="redirectStrategy"
			ref="jsfRedirectStrategy" />
	</beans:bean>


	<beans:bean id="jsfRedirectStrategy"
		class="br.com.tecnotran.bmi.controller.seguranca.JsfRedirectStrategy" />
	<beans:bean id="httpSessionSecurityContextRepository"
		class="org.springframework.security.web.context.HttpSessionSecurityContextRepository" />


	<beans:bean id="exceptionTranslationFilter"
		class="org.springframework.security.web.access.ExceptionTranslationFilter">
		<beans:property name="accessDeniedHandler"
			ref="jsfAccessDeniedHandler" />
		<beans:property name="authenticationEntryPoint"
			ref="authenticationEntryPoint" />
	</beans:bean>
	 fim redirecionamento -->

	<http auto-config="false" use-expressions="true">


		<intercept-url pattern="/Home.xhtml"
			access="isAuthenticated()" />
		<intercept-url pattern="/TrocarSenha.xhtml"
			access="isAuthenticated()" />
		<intercept-url pattern="/AcessoNegado.xhtml"
			access="isAuthenticated()" />
		<intercept-url pattern="/administracao/**"
			access="hasAnyRole('ADMINISTRADORES')" />
		<intercept-url pattern="/seguranca/**"
			access="hasAnyRole('ADMINISTRADORES')" />
		<intercept-url pattern="/boletim/**"
			access="hasAnyRole('ADMINISTRADORES', 'EMPRESAS')" />
		<intercept-url pattern="/relatorios/**"
			access="hasAnyRole('ADMINISTRADORES', 'EMPRESAS')" />
		<intercept-url pattern="/**" access="denyAll" />

		<form-login login-page="/Login.xhtml"
			authentication-failure-url="/Login.xhtml?invalid=true"
			default-target-url="/" always-use-default-target="true" />
		<logout logout-url="/j_spring_security_logout"
			invalidate-session="true" />

	</http>

	<authentication-manager>
		<authentication-provider
			user-service-ref="appUserDetailsService">

		</authentication-provider>
	</authentication-manager>

</beans:beans>